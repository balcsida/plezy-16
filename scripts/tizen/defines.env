# Build-time values of the TV build, one KEY=value per line. build.sh and
# check.sh pass this file with --dart-define-from-file.
#
# A key that is not set keeps upstream's value, and TRADEMARKS.md does not let
# a distributed fork use upstream's server or tracker registrations. Every one
# is set.
#
# Our server, the Cloudflare Worker in worker/: the log upload, and the sign-in
# proxy for MyAnimeList and AniList.
PLEZY_SERVER_URL=https://tizenhat.balcsida.workers.dev
# Our MyAnimeList app, the same ID as in worker/cloudflare.config.ts.
MAL_CLIENT_ID=1edda1cb4901e1e5571a2d189858e4de
# Our Trakt app. Trakt gave it no secret (it is registered for PKCE), and the
# empty value is what makes the app send none; unset, it would send upstream's.
TRAKT_CLIENT_ID=5zUL1uWuKF9fa_2vsM38WRG5UaBUEzAt4jHWfVw0LWo
TRAKT_CLIENT_SECRET=
# Our Simkl app (AUTH V2, device flow), and the name the build gives itself to
# Simkl and MDBList, which Simkl wants short and lower-case.
SIMKL_CLIENT_ID=c204ff7c87a6eebe003dff4a95b9d6ddac66953f68436859877d4006500c16e7
TRACKER_APP_NAME=plezy-16
# Simkl's older sign-in (AUTH V1), which we have no app for: the same ID as
# above. Simkl then answers a V1 token with 401 and the app asks to sign in
# again; an empty ID gets 412, which the app takes for a rate limit.
SIMKL_LEGACY_CLIENT_ID=c204ff7c87a6eebe003dff4a95b9d6ddac66953f68436859877d4006500c16e7
# Our MDBList app (device code flow).
MDBLIST_CLIENT_ID=8xZWAHbEr8D3PiIiOmmiCicvbWmQlvdXuJrqikus
