# Build-time values of the TV build, one KEY=value per line. build.sh and
# check.sh pass this file with --dart-define-from-file.
#
# A key that is not set keeps upstream's value, and TRADEMARKS.md does not let
# a distributed fork use upstream's server or tracker registrations.
#
# Our log server, the Cloudflare Worker in worker/. It has no sign-in proxy, so
# the MyAnimeList and AniList sign-in get no answer from it.
PLEZY_SERVER_URL=https://tizenhat.balcsida.workers.dev
#
# Not set yet, so these are still upstream's registrations:
# TRAKT_CLIENT_ID      our Trakt app
# TRAKT_CLIENT_SECRET
# SIMKL_CLIENT_ID      our Simkl AUTH V2 app (device flow)
# MDBLIST_CLIENT_ID    our MDBList Device Code app
# MAL_CLIENT_ID        our MyAnimeList app, the same ID the sign-in proxy is given
